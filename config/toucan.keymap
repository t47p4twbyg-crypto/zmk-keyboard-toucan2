#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：メインのキーマップ

        base {
            display-name = "MAC";
            bindings = <
&none  &new_behavior LG(Q) Q  &new_behavior LG(W) W  &kp E  &new_behavior LG(R) R  &new_behavior LG(T) T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &new_behavior LG(A) A  &new_behavior NUMBER_2 S  &new_behavior NUMBER_3 D  &new_behavior LG(F) F  &kp G  &new_behavior LG(H) H  &new_behavior N7 J  &new_behavior N8 K  &new_behavior N9 L  &new_behavior MINUS N0  &none  &none  &new_behavior LG(Z) Z  &new_behavior LG(X) X  &new_behavior LG(C) C  &new_behavior LG(V) V  &kp B  &new_behavior LG(N) N  &kp M  &kp COMMA  &kp DOT  &new_behavior ASTRK SLASH  &none  &kp LGUI  &kp LEFT_GUI  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        // レイヤー1：完全に空っぽ（&none）の部屋

        empty_layer1 {
            display-name = "L1";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // レイヤー2：完全に空っぽ（&none）の部屋

        empty_layer2 {
            display-name = "L2";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // レイヤー3：完全に空っぽ（&none）の部屋

        empty_layer3 {
            display-name = "L3";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // レイヤー4：完全に空っぽ（&none）の部屋

        empty_layer4 {
            display-name = "L4";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
