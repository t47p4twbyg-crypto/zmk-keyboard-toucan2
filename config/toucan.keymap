#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        behavior: behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        mouseback: mouseback {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEBACK";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        altshift: altshift {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTSHIFT";
            bindings = <&kt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：メインのキーマップ
        // レイヤー1：完全に空っぽ（&none）の部屋
        // レイヤー2：完全に空っぽ（&none）の部屋
        // レイヤー3：完全に空っぽ（&none）の部屋
        // レイヤー4：完全に空っぽ（&none）の部屋

        base {
            bindings = <
&trans  &behavior LC(Q) Q  &behavior LC(W) W  &behavior ESCAPE E  &behavior LC(R) R  &behavior LC(T) T  &behavior NUMBER_1 Y  &behavior NUMBER_2 U  &behavior NUMBER_3 I  &behavior NUMBER_4 O  &behavior N5 P  &trans  &trans  &behavior LC(A) A  &behavior LC(S) S  &behavior LS(F11) D  &behavior LC(F) F  &behavior LC(G) G  &behavior NUMBER_6 H  &behavior N7 J  &behavior N8 K  &behavior N9 L  &behavior N0 MINUS  &trans  &trans  &behavior LC(Z) Z  &behavior LC(X) X  &behavior LC(C) C  &behavior LC(V) V  &behavior LC(B) B  &behavior LC(N) N  &behavior PRINTSCREEN M  &behavior LC(LEFT_BRACKET) COMMA  &behavior LC(RIGHT_BRACKET) PERIOD  &behavior QUESTION SLASH  &trans  &to 1  &behavior LEFT_CONTROL LEFT_GUI  &behavior LEFT_SHIFT LEFT_ALT  &kp BACKSPACE  &kp ENTER  &kp SPACE
            >;
        };

        Yaji {
            bindings = <
&trans  &trans  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp TAB  &bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp F2  &kp END  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0  &kp LEFT_GUI  &kp LEFT_SHIFT  &behavior DELETE BACKSPACE  &behavior K_CONTEXT_MENU ENTER  &kp LEFT_CONTROL
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
