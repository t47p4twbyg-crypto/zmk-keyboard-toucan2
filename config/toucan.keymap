#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        behavior: behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        mouseback: mouseback {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEBACK";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        altshift: altshift {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTSHIFT";
            bindings = <&kt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：メインのキーマップ
        // レイヤー1：完全に空っぽ（&none）の部屋
        // レイヤー2：完全に空っぽ（&none）の部屋
        // レイヤー3：完全に空っぽ（&none）の部屋
        // レイヤー4：完全に空っぽ（&none）の部屋

        base {
            bindings = <
&trans  &behavior LC(Q) Q  &behavior LC(W) W  &behavior ESCAPE E  &behavior LC(R) R  &behavior LC(T) T  &behavior NUMBER_1 Y  &behavior NUMBER_2 U  &behavior NUMBER_3 I  &behavior NUMBER_4 O  &behavior N5 P  &trans  &trans  &behavior LC(A) A  &behavior LC(S) S  &behavior LS(F11) D  &behavior LC(F) F  &altshift LC(G) G  &altshift NUMBER_6 H  &altshift N7 J  &altshift N8 K  &altshift N9 L  &altshift N0 MINUS  &trans  &trans  &altshift LC(Z) Z  &altshift LC(X) X  &altshift LC(C) C  &altshift LC(V) V  &altshift LC(B) B  &altshift LC(N) N  &altshift C_MENU M  &mouseback MB4 COMMA  &mouseback MB5 PERIOD  &altshift QUESTION SLASH  &trans  &trans  &behavior LC(SPACE) LEFT_GUI  &behavior LG(TAB) TAB  &behavior DELETE BACKSPACE  &altshift ENTER SPACE  &altshift LEFT_SHIFT LG(SPACE)
            >;
        };

        Yaji {
            bindings = <
&trans  &trans  &kp UP_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
