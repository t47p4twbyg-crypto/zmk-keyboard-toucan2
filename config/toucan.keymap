#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        mouseback: mouseback {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEBACK";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：メインのキーマップ
        // レイヤー1：完全に空っぽ（&none）の部屋
        // レイヤー2：完全に空っぽ（&none）の部屋
        // レイヤー3：完全に空っぽ（&none）の部屋
        // レイヤー4：完全に空っぽ（&none）の部屋

        base {
            bindings = <
&trans  &mouseback LC(Q) Q  &mouseback LC(W) W  &mouseback ESCAPE E  &mouseback LC(R) R  &mouseback LC(T) T  &mouseback NUMBER_1 Y  &mouseback NUMBER_2 U  &mouseback NUMBER_3 I  &mouseback NUMBER_4 O  &mouseback N5 P  &trans  &trans  &mouseback LC(A) A  &mouseback LC(S) S  &mouseback LS(F11) D  &mouseback LC(F) F  &mouseback LC(G) G  &mouseback NUMBER_6 H  &mouseback N7 J  &mouseback N8 K  &mouseback N9 L  &mouseback N0 MINUS  &trans  &trans  &mouseback LC(Z) Z  &mouseback LC(X) X  &mouseback LC(C) C  &mouseback LC(V) V  &mouseback LC(B) B  &mouseback LC(N) N  &mouseback C_MENU M  &mouseback MB4 COMMA  &mouseback MB5 PERIOD  &mouseback QUESTION SLASH  &trans  &trans  &trans  &trans  &trans  &mouseback ENTER SPACE  &trans
            >;
        };

        Yaji {
            bindings = <
&trans  &trans  &kp UP_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
