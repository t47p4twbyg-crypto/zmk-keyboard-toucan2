#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：メインのキーマップ

        base {
            display-name = "base";
            bindings = <
&none  &new_behavior LC(Q) Q  &new_behavior LC(W) W  &kp E  &new_behavior LC(R) R  &new_behavior LC(T) T  &kp Y  &kp U  &kp I  &kp O  &new_behavior LG(P) P  &none  &none  &new_behavior LC(A) A  &new_behavior LC(S) S  &kp D  &new_behavior LC(F) F  &kp G  &new_behavior LC(H) H  &kp J  &new_behavior LC(K) K  &new_behavior LG(L) L  &kp MINUS  &none  &none  &new_behavior LC(Z) Z  &new_behavior LC(X) X  &new_behavior LC(C) C  &new_behavior LC(V) V  &kp B  &new_behavior LC(N) N  &kp M  &kp COMMA  &kp DOT  &new_behavior ASTRK SLASH  &none  &kp LA(TAB)  &kp LEFT_CONTROL  &lt 1 SPACE  &new_behavior DELETE BACKSPACE  &new_behavior PRINTSCREEN ENTER  &new_behavior CAPS LG(SPACE)
            >;
        };

        // レイヤー1：完全に空っぽ（&none）の部屋

        empty_layer1 {
            display-name = "lay";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // レイヤー2：完全に空っぽ（&none）の部屋

        empty_layer2 {
            display-name = "L2";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // レイヤー3：完全に空っぽ（&none）の部屋

        empty_layer3 {
            display-name = "L3";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        // レイヤー4：完全に空っぽ（&none）の部屋

        empty_layer4 {
            display-name = "L4";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
