#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        behavior: behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        mouseback: mouseback {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEBACK";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        altshift: altshift {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTSHIFT";
            bindings = <&kt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：メインのキーマップ
        // レイヤー1：完全に空っぽ（&none）の部屋
        // レイヤー2：完全に空っぽ（&none）の部屋
        // レイヤー3：完全に空っぽ（&none）の部屋
        // レイヤー4：完全に空っぽ（&none）の部屋

        base {
            bindings = <
&trans  &behavior LC(Q) Q  &behavior LC(W) W  &behavior ESCAPE E  &behavior LC(R) R  &behavior LC(T) T  &behavior NUMBER_1 Y  &behavior NUMBER_2 U  &behavior NUMBER_3 I  &behavior NUMBER_4 O  &behavior N5 P  &trans  &trans  &behavior LC(A) A  &behavior LC(S) S  &behavior LS(F11) D  &behavior LC(F) F  &behavior LC(G) G  &behavior NUMBER_6 H  &behavior N7 J  &behavior N8 K  &behavior N9 L  &behavior N0 MINUS  &trans  &trans  &behavior LC(Z) Z  &behavior LC(X) X  &behavior LC(C) C  &behavior LC(V) V  &behavior LC(B) B  &behavior LC(N) N  &behavior PRINTSCREEN M  &mouseback MB4 COMMA  &mouseback MB5 PERIOD  &behavior QUESTION SLASH  &trans  &lt 1 LEFT_ALT  &behavior LC(SPACE) LEFT_GUI  &behavior LG(TAB) TAB  &behavior DELETE BACKSPACE  &behavior ENTER SPACE  &altshift LEFT_SHIFT LG(SPACE)
            >;
        };

        Yaji {
            bindings = <
&trans  &trans  &trans  &behavior PAGE_UP UP_ARROW  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &behavior HOME LEFT  &behavior PAGE_DOWN DOWN  &behavior END RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0  &kp LEFT_GUI  &kp LEFT_CONTROL  &trans  &kp LEFT_SHIFT  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
